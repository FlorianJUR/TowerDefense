<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TowerDefenseApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TowerDefenseApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        Icon="/Assets/avalonia-logo.ico"
        Title="TowerDefenseApp">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>
    
    <Grid>
    <!--tiles-->
        <ItemsControl ItemsSource="{Binding tilesview}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding posX}" />
                    <Setter Property="Canvas.Top" Value="{Binding posY}" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="{Binding width}"
                            Height="{Binding height}"
                            Fill="{Binding color}"
                            Tapped="OnTileTapped" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    <!--towers range-->
        <ItemsControl ItemsSource="{Binding towersview}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding rangeX}" />
                    <Setter Property="Canvas.Top" Value="{Binding rangeY}" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Ellipse Width="{Binding rangeDiameter}"
                            Height="{Binding rangeDiameter}"
                            Fill="#11ffffff"
                            Stroke="#44ffffff"
                            StrokeThickness="1" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    <!--towers-->
        <ItemsControl ItemsSource="{Binding towersview}" IsHitTestVisible="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ItemsControl > ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding posX}" />
                    <Setter Property="Canvas.Top" Value="{Binding posY}" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Rectangle Width="{Binding width}"
                            Height="{Binding height}"
                            Fill="{Binding color}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Canvas IsHitTestVisible="False">
        <Rectangle Width="32" Height="32"
                Stroke="White" StrokeThickness="3"
                IsVisible="{Binding IsTileSelected}"
                Canvas.Left="{Binding SelectedX}"
                Canvas.Top="{Binding SelectedY}" />
        </Canvas>
    <!--enemy-->
        <Canvas>
            <Ellipse Width="20" Height="20" Fill="Black"
                    Canvas.Left="{Binding EnemyX}"
                    Canvas.Top="{Binding EnemyY}" />
        </Canvas>
        <TextBlock Text="{Binding TimeText}"
                FontSize="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10" />
        <TextBlock Text="{Binding HealthText}"
                FontSize="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="10" />
    <!--tower button-->
        <StackPanel HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="10"
                    Spacing="5">

            <Button Content="TOUR"
                    FontSize="24"
                    Width="150"
                    Height="60"
                    HorizontalAlignment="Right"
                    Click="OnBuildClicked" />

            <TextBlock Text="{Binding MessageText}"
                    FontSize="16"
                    Width="250"
                    Height="40"
                    TextWrapping="Wrap"
                    TextAlignment="Right" />
        </StackPanel>
    </Grid>
</Window>